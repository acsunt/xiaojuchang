name = "replace-me"
compatibility_date = "2026-07-08"
pages_build_output_dir = "dist"
# 复制为 wrangler.local.toml 后填入真实项目名和 D1 database_id。
# wrangler.local.toml 只留在本机，不要提交到 GitHub。
# Cloudflare Pages 固定部署到 main 别名。

[[d1_databases]]
binding = "DB"
database_name = "replace-me"
database_id = "replace-me"